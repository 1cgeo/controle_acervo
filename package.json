{
  "name": "controle-acervo",
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Controle do Acervo",
  "repository": {
    "type": "git",
    "url": "git://github.com/1cgeo/controle_acervo"
  },
  "scripts": {
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "install-client": "cd client && npm install",
    "dev-client": "cd client && npm run dev",
    "build-client": "cd client && npm run build",
    "test-client": "cd client && npm test",
    "test-cli": "node --test acervo_cli/__tests__/*.test.js mapoteca_cli/__tests__/*.test.js orcamento_cli/__tests__/*.test.js efetivo_cli/__tests__/*.test.js pit_cli/__tests__/*.test.js equipamento_cli/__tests__/*.test.js sag_cli/__tests__/*.test.js",
    "test-scripts": "node --test scripts/__tests__/*.test.js",
    "config": "node create_config.js",
    "build": "node create_build.js",
    "start": "pm2 start server/src/index.js --name controle-acervo",
    "deploy": "npm run build && pm2 startOrReload ecosystem.config.cjs && pm2 save",
    "start-dev": "concurrently \"cd server && npm run dev\""
  },
  "keywords": [
    "Controle do Acervo",
    "Node",
    "Express"
  ],
  "author": "DSG/1CGEO <diniz.felipe@eb.mil.br>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/1cgeo/controle_acervo/issues"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "inquirer": "^13.3.0",
    "pg-promise": "^12.6.1",
    "pm2": "^7.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
